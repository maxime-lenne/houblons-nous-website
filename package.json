{
  "name": "houblons-nous-website",
  "version": "1.0.0",
  "description": "Houblons Nous — static site built with Jekyll and jekyll-baserow-headless-cms",
  "type": "module",
  "main": "index.js",
  "author": "Maxime Lenne",
  "license": "MIT",
  "private": true,
  "keywords": [
    "jekyll",
    "baserow",
    "github-pages"
  ],
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "bun run lint:md && bun run lint:yaml && bun run lint:commit",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore _site --ignore vendor",
    "lint:md:fix": "markdownlint '**/*.md' --ignore node_modules --ignore _site --ignore vendor --fix",
    "lint:yaml": "yamllint .",
    "lint:commit": "commitlint --last -V",
    "prepare": "husky",
    "commit": "gitmoji -c",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "setup:github": "bun scripts/setup-github.js",
    "clean:branches": "bun scripts/clean-branches.js",
    "sync:develop": "bun scripts/sync-develop.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "gitmoji-cli": "^9.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdownlint-cli": "^0.49.1",
    "semantic-release": "^25.0.9"
  },
  "lint-staged": {
    "*.md": "markdownlint --fix",
    "!(baserow_locations|quartier_assos).{yml,yaml}": "yamllint"
  }
}
