# Copy to .env and fill in to enable Baserow CMS (set baserow.enabled: true in _config.yml first)
BASEROW_TOKEN=
BASEROW_LOCATIONS_TABLE=757

# Each *_TABLE below is optional — leave it blank and the matching section
# falls back to the local Jekyll collection (_ca/, _bureau/, etc.) instead
# of breaking the build. Fill one in once its table exists in Baserow, see
# docs/AGENTS.md#baserow-cms for the exact field list per table.
BASEROW_CA_TABLE=
BASEROW_BUREAU_TABLE=
BASEROW_BENEVOLES_TABLE=
BASEROW_BIERES_TABLE=
BASEROW_EVENEMENTS_TABLE=
BASEROW_ASSOCIATIONS_TABLE=
BASEROW_QUARTIER_EVENEMENTS_TABLE=

# Optional: only needed for a self-hosted Baserow instance
BASEROW_API_URL=https://houblons-nous.white-wood.tech
